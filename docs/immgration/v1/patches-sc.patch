+                    input_topk_ids + output_topk_ids, dtype=torch.int32
+                ).unsqueeze(0)  # [1, seq_len, k]
+                result["sampler_topk_logps"] = torch.tensor(
+                    input_topk_logps + output_topk_logps, dtype=torch.float32
+                ).unsqueeze(0)  # [1, seq_len, k]
