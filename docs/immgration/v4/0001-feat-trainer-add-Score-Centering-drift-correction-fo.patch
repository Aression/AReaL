+        # SC + unsupported combinations fail fast.
+        if self.use_score_centering:
+            # Plan A replaces the PPO clipped surrogate, so a separate
+            # importance-sampling correction stage computed inside that
+            # surrogate would be silently discarded. Plan B keeps the PPO loss
+            # and therefore composes with it.
+            if (
+                self.importance_sampling is not None
